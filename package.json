{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@tituskirch/profile",
  "version": "0.1.0",
  "private": true,
  "description": "Sources for the github.com/TitusKirch profile README — manifest + renderer for the auto-synced projects list.",
  "homepage": "https://github.com/TitusKirch/TitusKirch#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/TitusKirch/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/TitusKirch.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "render:check": "node scripts/render-readme.mjs && git diff --exit-code README.md",
    "check": "pnpm lint && pnpm format && pnpm render:check",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "render": "node scripts/render-readme.mjs",
    "bootstrap:descriptions": "node scripts/bootstrap-descriptions.mjs",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "dependencies": {
    "js-yaml": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "taze": "^21.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
